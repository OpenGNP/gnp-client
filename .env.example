VITE_API_URL=http://localhost:3000/api

# Microsoft sign-in (Entra ID app registration). Leave CLIENT_ID empty to hide the
# "Sign in with Microsoft" button. TENANT_ID: "common" (any account), "organizations" (work/school only), or a directory GUID.
# Register <origin>/redirect.html as a Single-page application redirect URI.
VITE_MSAL_CLIENT_ID=
VITE_MSAL_TENANT_ID=common
